# -----------------------------------------------------------------------------
# ScaleLink Microservices Environment Configuration Template
# Copy this file to .env before starting services with Docker Compose
# -----------------------------------------------------------------------------

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_LINK_DB=link_db
POSTGRES_ANALYTICS_DB=analytics_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Apache Kafka Configuration
KAFKA_BROKER=kafka:29092
KAFKA_TOPIC_CLICKS=url.clicks.v1

# OpenTelemetry & Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=scalelink-platform

# API Gateway & External Access
GATEWAY_PORT=80
JAVA_SERVICE_PORT=8080
PYTHON_SERVICE_PORT=8000
JAEGER_UI_PORT=16686
KAFDROP_UI_PORT=9000
